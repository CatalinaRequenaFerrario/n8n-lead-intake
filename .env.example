# Copia este archivo a .env y rellena los valores. .env no se sube al repo.

# Clave con la que n8n cifra las credenciales guardadas en el volumen.
# Genera una con: openssl rand -hex 32
# Si la cambias o la pierdes, las credenciales guardadas dejan de poder leerse.
N8N_ENCRYPTION_KEY=

GENERIC_TIMEZONE=Europe/Madrid
TZ=Europe/Madrid

N8N_DIAGNOSTICS_ENABLED=false
